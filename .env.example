DB_HOST=127.0.0.1
DB_PORT=15432
POSTGRES_PASSWORD=
MEMBER_DB_PASSWORD=
SAFETY_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
FOOD_SAFETY_API_KEY=
SAFETY_KOREA_API_KEY=

# Start infra/compose/kafka.yml and create the topic before enabling alerts.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
ALERTS_ENABLED=false
ALERT_TOPIC=reguard.recall-alerts.v1
MEMBER_BASE_URL=http://127.0.0.1:8081
SAFETY_BASE_URL=http://127.0.0.1:8082

# Configure provider credentials only in ignored .env; never commit real secrets.
MAIL_ENABLED=false
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Both Member and Notification: false for local HTTP, true for HTTPS deployment.
COOKIE_SECURE=false
WEB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Development proxy targets (server-side only; never use VITE_ for secrets)
MEMBER_SERVICE_URL=http://127.0.0.1:8081
SAFETY_SERVICE_URL=http://127.0.0.1:8082
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8083

# Server-only runtime configuration; no services are started by these values.
PUBLIC_DOMAIN=
RUNTIME_DB_HOST=postgres
RUNTIME_KAFKA_SERVERS=kafka:9092
RUNTIME_APPLICATION_NETWORK=reguard-local_default
RUNTIME_EVENTS_NETWORK=reguard-events_default
