{
  "name": "reguard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "test": "node --test *.test.js",
    "format": "prettier --write \"**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,css}\"",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "jsdom": "^30.1.2",
    "prettier": "3.6.2",
    "vite": "8.3.1",
    "vitest": "^5.0.4"
  }
}
