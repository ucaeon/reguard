{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "ReGuard single-node evaluation infrastructure. Creates billable resources only when deployed. Application installation is separate.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "PublicSubnetId": {
      "Type": "AWS::EC2::Subnet::Id",
      "Description": "Public subnet in VpcId with a route to an Internet Gateway."
    },
    "ImageId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t4g.large",
      "AllowedValues": [
        "t4g.large"
      ],
      "Description": "Candidate only; validate collection and backup memory peaks before launch."
    },
    "StopAfterHours": {
      "Type": "Number",
      "Default": 144,
      "MinValue": 1,
      "MaxValue": 144,
      "Description": "Shutdown deadline from first boot; EBS and S3 remain billable after stopping."
    }
  },
  "Resources": {
    "Backups": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "BackupRetention",
              "Status": "Enabled",
              "Prefix": "reguard/",
              "ExpirationInDays": 14,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 14
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "reguard"
          }
        ]
      }
    },
    "BackupPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Backups"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Backups",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Backups.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "NodeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "ec2.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "BackupObjects",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Backups",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": [
                        "reguard/*"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject",
                    "s3:AbortMultipartUpload"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Backups.Arn}/reguard/*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "NodeProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "NodeRole"
          }
        ]
      }
    },
    "WebSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Public web only; administrative access uses SSM",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "Node": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "ImageId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "IamInstanceProfile": {
          "Ref": "NodeProfile"
        },
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1
        },
        "InstanceInitiatedShutdownBehavior": "stop",
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeType": "gp3",
              "VolumeSize": 60,
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "PublicSubnetId"
            },
            "GroupSet": [
              {
                "Ref": "WebSecurityGroup"
              }
            ]
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#!/bin/bash\nset -euo pipefail\ninstall -d -m 700 /var/lib/reguard\nif [ ! -s /var/lib/reguard/stop-at ]; then\n  date -u -d '+${StopAfterHours} hours' '+%Y-%m-%d %H:%M:%S UTC' > /var/lib/reguard/stop-at\nfi\ncat > /etc/systemd/system/reguard-budget-stop.service <<'UNIT'\n[Unit]\nDescription=Stop evaluation server at its budget deadline\n[Service]\nType=oneshot\nExecStart=/usr/bin/systemctl poweroff\nUNIT\nprintf '[Unit]\\nDescription=Evaluation deadline\\n[Timer]\\nOnCalendar=%s\\nPersistent=true\\nAccuracySec=1min\\n[Install]\\nWantedBy=timers.target\\n' \"$(cat /var/lib/reguard/stop-at)\" > /etc/systemd/system/reguard-budget-stop.timer\nsystemctl daemon-reload\nsystemctl enable --now reguard-budget-stop.timer\nsystemctl enable --now amazon-ssm-agent\n"
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "reguard-evaluation"
          },
          {
            "Key": "Project",
            "Value": "reguard"
          }
        ]
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Node"
      }
    },
    "PublicIp": {
      "Value": {
        "Fn::GetAtt": [
          "Node",
          "PublicIp"
        ]
      }
    },
    "BackupBucket": {
      "Value": {
        "Ref": "Backups"
      }
    },
    "RetentionNotice": {
      "Value": "Stopping does not delete EBS. Stack deletion retains backup bucket. Export and verify data before deleting the instance."
    }
  }
}
